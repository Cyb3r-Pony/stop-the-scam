# Public configuration only — Vite inlines these into the shipped bundle,
# so never put an API key here. Provider keys live as Cloudflare Worker
# secrets; see worker/README.md.

# Base URL of the deployed threat-intelligence proxy.
# Leave unset and the domain checker still works: it falls back to the
# DNS-only scorecard plus direct links to the providers' own sites.
VITE_API_BASE=https://sts-api.YOUR-SUBDOMAIN.workers.dev
